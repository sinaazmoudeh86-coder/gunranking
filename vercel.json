{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!assets/|robots\\.txt|sitemap.*\\.xml|llms\\.txt|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      320,
      640,
      1080
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "nip.grabagun.org"
      },
      {
        "protocol": "https",
        "hostname": "upload.wikimedia.org"
      },
      {
        "protocol": "https",
        "hostname": "grabagun.com"
      }
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 86400
  }
}